<?xml version="1.0" encoding="UTF-8"?>

<Shell
    x:Class="Privault.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Privault.Views"
    Title="PriVault"
    Shell.NavBarIsVisible="False"
    FlyoutBehavior="Disabled"> 
    <!-- FlyoutBehavior Disabled verhindert, dass man ein Menü aufwischen kann -->

    <!-- 1. Der Login Screen -->
    <ShellContent
        Title="Login"
        ContentTemplate="{DataTemplate views:LoginPage}"
        Route="LoginPage" />

    <!-- 2. Die Hauptansicht -->
    <!-- Indem es hier steht, wird es eine "Root Page", zu der man mit "///" navigieren kann -->
    <ShellContent
        Title="Tresor"
        ContentTemplate="{DataTemplate views:MainPage}"
        Route="MainPage" />

</Shell>