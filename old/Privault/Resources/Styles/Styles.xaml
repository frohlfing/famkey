<?xml version="1.0" encoding="UTF-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <!-- ========================================================== -->
    <!-- Layout -->
    <!-- ========================================================== -->

    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="Padding" Value="0" />
        <Setter Property="BackgroundColor" Value="{DynamicResource PageBackgroundColor}" />
    </Style>

    <Style TargetType="ScrollView">
        <Setter Property="Padding" Value="{DynamicResource PagePadding}" />
    </Style>

    <Style x:Key="Header" TargetType="Grid">
        <Setter Property="BackgroundColor" Value="{DynamicResource HeaderBackgroundColor}" />
        <Setter Property="Padding" Value="{DynamicResource HeaderPadding}" />
    </Style>

    <Style x:Key="LoginHeader" TargetType="VerticalStackLayout">
        <Setter Property="Padding" Value="{DynamicResource LoginHeaderPadding}" />
        <Setter Property="Spacing" Value="{DynamicResource LoginHeaderSpacing}" />
    </Style>

    <Style x:Key="Body" TargetType="VerticalStackLayout">
        <Setter Property="Spacing" Value="{DynamicResource BodySpacing}" />
    </Style>

    <Style x:Key="SectionGroup" TargetType="VerticalStackLayout">
        <Setter Property="Spacing" Value="{DynamicResource SectionSpacing}" />
    </Style>

    <Style x:Key="FieldGroup" TargetType="VerticalStackLayout">
        <Setter Property="Spacing" Value="{DynamicResource FieldSpacing}" />
    </Style>

    <Style x:Key="TwoColumnGrid" TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="{DynamicResource TwoColumnGridSpacing}" />
    </Style>

    <Style x:Key="FriendName" TargetType="HorizontalStackLayout">
        <Setter Property="Spacing" Value="{DynamicResource InlineSpacing}" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- ========================================================== -->
    <!-- Menüs/Popups und Dialoge -->
    <!-- ========================================================== -->
    
    <Style x:Key="PopupSurface" TargetType="VerticalStackLayout">
        <Setter Property="Spacing" Value="5" />
        <Setter Property="Padding" Value="10" />
    </Style>
   
    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="StrokeShape" Value="RoundRectangle 14" /> <!-- CornerRadius -->
        <Setter Property="Stroke" Value="{DynamicResource SurfaceBorderColor}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Shadow" Value="{DynamicResource SurfaceShadow}" />
    </Style>

    <!-- ========================================================== -->
    <!-- Typography -->
    <!-- ========================================================== -->

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource TextPrimaryColor}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="{DynamicResource DefaultFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource DefaultFontSize}" />
    </Style>

    <Style x:Key="AppTitle" TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource TextPrimaryColor}" />
        <Setter Property="FontSize" Value="{DynamicResource HeadlineFontSize}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="HorizontalOptions" Value="Center" />
    </Style>

    <Style x:Key="SubAppTitle" TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource TextMutedColor}" />
        <Setter Property="FontSize" Value="{DynamicResource CaptionFontSize}" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="Margin" Value="{DynamicResource CaptionMargin}" />
    </Style>

    <Style x:Key="HeaderTitle" TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource TextPrimaryColor}" />
        <Setter Property="FontSize" Value="{DynamicResource HeaderTitleFontSize}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="Label">
        <Setter Property="FontSize" Value="{DynamicResource SectionTitleFontSize}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource AccentColor}" />
    </Style>
    
    <Style x:Key="FieldLabel" TargetType="Label">
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style x:Key="Hint" TargetType="Label">
        <Setter Property="FontSize" Value="{DynamicResource HintFontSize}" />
        <Setter Property="TextColor" Value="{DynamicResource TextMutedColor}" />
    </Style>

    <Style x:Key="AuditHint" TargetType="Label">
        <Setter Property="FontSize" Value="{DynamicResource SmallFontSize}" />
        <Setter Property="TextColor" Value="{DynamicResource TextMutedColor}" />
    </Style>

    <Style x:Key="AttachmentMetaSubtitle" TargetType="Label">
        <Setter Property="FontSize" Value="{DynamicResource SmallFontSize}" />
        <Setter Property="TextColor" Value="{DynamicResource TextMutedColor}" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

    <Style x:Key="FilterLabel" TargetType="Label">
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="FontSize" Value="{DynamicResource SmallFontSize}" />
    </Style>

    <Style x:Key="Fingerprint" TargetType="Label">
        <Setter Property="FontSize" Value="{DynamicResource TinyFontSize}" />
        <Setter Property="TextColor" Value="{DynamicResource AccentColor}" />
        <Setter Property="FontFamily" Value="Monospace" />
        <Setter Property="LineBreakMode" Value="CharacterWrap" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

    <!-- ========================================================== -->
    <!-- Inputs -->
    <!-- ========================================================== -->

    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{DynamicResource InputTextColor}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource InputPlaceholderColor}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource InputBackgroundColor}" />
        <Setter Property="FontFamily" Value="{DynamicResource DefaultFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource DefaultFontSize}" />
        <Setter Property="HeightRequest" Value="{DynamicResource InputHeight}" />
    </Style>

    <Style TargetType="Editor">
        <Setter Property="TextColor" Value="{DynamicResource InputTextColor}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource InputPlaceholderColor}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource InputBackgroundColor}" />
        <Setter Property="FontFamily" Value="{DynamicResource DefaultFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource DefaultFontSize}" />
        <Setter Property="MinimumHeightRequest" Value="{DynamicResource EditorMinHeight}" />
        <Setter Property="VerticalOptions" Value="Fill" />
    </Style>

    <Style TargetType="Picker">
        <Setter Property="TextColor" Value="{DynamicResource InputTextColor}" />
        <Setter Property="TitleColor" Value="{DynamicResource InputPlaceholderColor}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource InputBackgroundColor}" />
        <Setter Property="FontFamily" Value="{DynamicResource DefaultFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource DefaultFontSize}" />
        <Setter Property="HeightRequest" Value="{DynamicResource InputHeight}" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

    <Style TargetType="SearchBar">
        <Setter Property="TextColor" Value="{DynamicResource InputTextColor}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource InputPlaceholderColor}" />
        <!-- <Setter Property="BackgroundColor" Value="Transparent" /> -->
        <Setter Property="BackgroundColor" Value="{DynamicResource InputBackgroundColor}" />
        <Setter Property="CancelButtonColor" Value="{DynamicResource AccentColor}" />
        <Setter Property="ios:SearchBar.SearchBarStyle" Value="Minimal" />
    </Style>

    <Style x:Key="SearchBarBorder" TargetType="Border">
        <Setter Property="Margin" Value="{DynamicResource SearchMargin}" />
        <Setter Property="Padding" Value="{DynamicResource SearchPadding}" />
        <Setter Property="StrokeShape" Value="{DynamicResource SearchShape}" />
        <Setter Property="StrokeThickness" Value="{DynamicResource BorderStrokeThickness}" />
        <Setter Property="Stroke" Value="{DynamicResource BorderColor}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource InputBackgroundColor}" />
        <Setter Property="HeightRequest" Value="{DynamicResource SearchHeight}" />
    </Style>

    <Style TargetType="Switch">
        <Setter Property="OnColor" Value="{DynamicResource AccentColor}"></Setter>
    </Style>
    
    <Style TargetType="CheckBox">
        <Setter Property="Color" Value="{DynamicResource AccentColor}" />
        <Setter Property="MinimumHeightRequest" Value="{DynamicResource ButtonMinHeight}" />
    </Style>
    
    <!-- ========================================================== -->
    <!-- Buttons -->
    <!-- ========================================================== -->

    <Style TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource ButtonBackgroundColor}" />
        <Setter Property="TextColor" Value="{DynamicResource ButtonTextColor}" />
        <Setter Property="FontFamily" Value="{DynamicResource DefaultFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource DefaultFontSize}" />

        <Setter Property="BorderWidth" Value="{DynamicResource BorderStrokeThickness}" />
        <Setter Property="BorderColor" Value="{DynamicResource BorderColor}" />

        <Setter Property="CornerRadius" Value="{DynamicResource ButtonCornerRadius}" />
        <Setter Property="Padding" Value="{DynamicResource ButtonPadding}" />
        <Setter Property="MinimumHeightRequest" Value="{DynamicResource ButtonMinHeight}" />
        <Setter Property="Shadow" Value="{DynamicResource ButtonShadow}" />

        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource ButtonDisabledBackgroundColor}" />
                            <Setter Property="TextColor" Value="{DynamicResource ButtonDisabledTextColor}" />
                            <Setter Property="BorderColor" Value="{DynamicResource SurfaceBorderColor}" />
                            <Setter Property="Shadow" Value="{DynamicResource DisabledShadow}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource ButtonPressedBackgroundColor}" />
                            <Setter Property="Shadow" Value="{DynamicResource ButtonPressedShadow}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="FullButton" TargetType="Button">
        <Setter Property="CornerRadius" Value="{DynamicResource ButtonCornerRadius}" />
        <Setter Property="HeightRequest" Value="{DynamicResource FullButtonHeight}" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style x:Key="DangerFullButton" TargetType="Button" BasedOn="{StaticResource FullButton}">
        <Setter Property="BackgroundColor" Value="{DynamicResource DangerColor}" />
        <Setter Property="TextColor" Value="{DynamicResource DangerOnColor}" />
    </Style>

    <Style x:Key="SmallButton" TargetType="Button">
        <Setter Property="FontSize" Value="{DynamicResource SmallFontSize}" />
        <Setter Property="HeightRequest" Value="{DynamicResource SmallButtonHeight}" />
        <Setter Property="Margin" Value="{DynamicResource IconButtonMargin}" />
    </Style>

    <Style x:Key="DangerSmallButton" TargetType="Button" BasedOn="{StaticResource SmallButton}">
        <Setter Property="BackgroundColor" Value="{DynamicResource DangerColor}" />
        <Setter Property="TextColor" Value="{DynamicResource DangerOnColor}" />
    </Style>

    <Style x:Key="TinyButton" TargetType="Button">
        <Setter Property="FontSize" Value="{DynamicResource TinyFontSize}" />
        <Setter Property="HeightRequest" Value="{DynamicResource TinyButtonHeight}" />
        <Setter Property="WidthRequest" Value="{DynamicResource TinyButtonWidth}" />
        <Setter Property="Padding" Value="{DynamicResource TinyButtonPadding}" />
    </Style>

    <Style x:Key="HeaderButton" TargetType="Button">
        <Setter Property="FontSize" Value="{DynamicResource SmallFontSize}" />
        <Setter Property="WidthRequest" Value="{DynamicResource HeaderButtonWidth}" />
        <Setter Property="Margin" Value="{DynamicResource HeaderButtonMargin}" />
    </Style>

    <Style x:Key="IconButtonGroup" TargetType="HorizontalStackLayout">
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="Spacing" Value="{DynamicResource InlineSpacing}" />
        <Setter Property="Padding" Value="{DynamicResource SmallButtonPadding}" />
    </Style>

    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="FontFamily" Value="MaterialIcons" />
        <Setter Property="FontSize" Value="{DynamicResource IconButtonFontSize}" />
        <Setter Property="WidthRequest" Value="{DynamicResource IconButtonWidth}" />
        <Setter Property="HeightRequest" Value="{DynamicResource IconButtonWidth}" />
        <Setter Property="Margin" Value="{DynamicResource IconButtonMargin}" />
    </Style>

    <Style x:Key="FloatingButton" TargetType="Button">
        <Setter Property="HorizontalOptions" Value="End" />
        <Setter Property="VerticalOptions" Value="End" />
        <Setter Property="Margin" Value="{DynamicResource FabMargin}" />
        <Setter Property="WidthRequest" Value="{DynamicResource FabSize}" />
        <Setter Property="HeightRequest" Value="{DynamicResource FabSize}" />
        <Setter Property="CornerRadius" Value="{DynamicResource FabCornerRadius}" />
        <Setter Property="FontSize" Value="{DynamicResource FabFontSize}" />
        <Setter Property="Shadow" Value="{Shadow Brush=Black, Offset='2,2', Opacity=0.5}" />
    </Style>

    <Style x:Key="ChipButtonGroup" TargetType="CollectionView">
        <Setter Property="HeightRequest" Value="{DynamicResource ChipGroupHeight}" />
        <Setter Property="Margin" Value="{DynamicResource ChipGroupMargin}" />
    </Style>

    <Style x:Key="ChipButton" TargetType="Button">
        <Setter Property="FontSize" Value="{DynamicResource SmallFontSize}" />
        <Setter Property="Padding" Value="{DynamicResource ChipPadding}" />
        <Setter Property="HeightRequest" Value="{DynamicResource ChipHeight}" />
        <Setter Property="MinimumHeightRequest" Value="{DynamicResource ChipHeight}" />
        <Setter Property="MinimumWidthRequest" Value="{DynamicResource ChipMinWidth}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ChipCornerRadius}" />
    </Style>
   
    <Style x:Key="RadioButtonGroup" TargetType="HorizontalStackLayout">
        <Setter Property="Spacing" Value="0" />
    </Style>
    
    <Style x:Key="RadioButton" TargetType="Button">
        <Setter Property="FontSize" Value="{DynamicResource TinyFontSize}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="WidthRequest" Value="{DynamicResource AccessButtonWidth}" />
        <Setter Property="HeightRequest" Value="{DynamicResource AccessButtonHeight}" />
        <Setter Property="MinimumHeightRequest" Value="{DynamicResource AccessButtonHeight}" />
        <Setter Property="CornerRadius" Value="{DynamicResource AccessButtonCornerRadius}" />
        <Setter Property="TextColor" Value="{DynamicResource AccessSelectedTextColor}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource AccessSelectedOffBackgroundColor}" />
    </Style>

    <!-- ========================================================== -->
    <!-- Loader / Overlay -->
    <!-- ========================================================== -->

    <Style x:Key="Overlay" TargetType="Grid">
        <Setter Property="BackgroundColor" Value="{DynamicResource OverlayBackgroundColor}" />
        <Setter Property="InputTransparent" Value="False" />
        <Setter Property="ZIndex" Value="20" />
    </Style>

    <Style x:Key="Loader" TargetType="VerticalStackLayout">
        <Setter Property="Spacing" Value="{DynamicResource InlineSpacing}" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="InputTransparent" Value="True" />
        <Setter Property="ZIndex" Value="20" />
    </Style>

    <Style x:Key="LoaderText" TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource TextMutedColor}" />
        <Setter Property="FontSize" Value="{DynamicResource SmallFontSize}" />
        <Setter Property="HorizontalOptions" Value="Center" />
    </Style>

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{DynamicResource TextMutedColor}" />
    </Style>

    <!-- ========================================================== -->
    <!-- Meter -->
    <!-- ========================================================== -->

    <Style x:Key="Meter" TargetType="Grid">
        <Setter Property="Margin" Value="{DynamicResource MeterMargin}" />
    </Style>

    <Style x:Key="MeterBar" TargetType="ProgressBar">
        <Setter Property="HeightRequest" Value="{DynamicResource MeterBarHeight}" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="Margin" Value="{DynamicResource MeterBarMargin}" />
    </Style>

    <Style x:Key="MeterLabel" TargetType="Label">
        <Setter Property="FontSize" Value="{DynamicResource SmallFontSize}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- ========================================================== -->
    <!-- Warning -->
    <!-- ========================================================== -->

    <Style x:Key="WarningBox" TargetType="Border">
        <Setter Property="StrokeThickness" Value="{DynamicResource BorderStrokeThickness}" />
        <Setter Property="Stroke" Value="{DynamicResource WarningColor}" />
        <Setter Property="Padding" Value="{DynamicResource WarningPadding}" />
        <Setter Property="Margin" Value="{DynamicResource WarningMargin}" />
    </Style>

    <Style x:Key="WarningBoxTitle" TargetType="Label">
        <Setter Property="FontSize" Value="{DynamicResource DefaultFontSize}" />
        <Setter Property="TextColor" Value="{DynamicResource WarningColor}" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style x:Key="WarnIcon" TargetType="Label">
        <Setter Property="FontSize" Value="{DynamicResource DefaultFontSize}" />
        <Setter Property="TextColor" Value="{DynamicResource DangerColor}" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

    <!-- ========================================================== -->
    <!-- Images -->
    <!-- ========================================================== -->

    <Style x:Key="Thumbnail" TargetType="Image">
        <Setter Property="WidthRequest" Value="{DynamicResource ThumbnailSize}" />
        <Setter Property="HeightRequest" Value="{DynamicResource ThumbnailSize}" />
        <Setter Property="Aspect" Value="AspectFill" />
        <Setter Property="InputTransparent" Value="True" />
    </Style>

    <Style x:Key="AttachmentMetaColumn" TargetType="VerticalStackLayout">
        <Setter Property="Spacing" Value="{DynamicResource MetaSpacing}" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="InputTransparent" Value="True" />
    </Style>

    <!-- ========================================================== -->
    <!-- Collection (einheitlich für Main/Settings/Detail) -->
    <!-- ========================================================== -->

    <Style x:Key="Collection" TargetType="CollectionView">
        <Setter Property="Margin" Value="{DynamicResource CollectionMargin}" />
    </Style>

    <Style x:Key="CollectionHeader" TargetType="Grid">
        <Setter Property="Padding" Value="{DynamicResource GroupHeaderPadding}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

    <Style x:Key="CollectionHeaderRow" TargetType="HorizontalStackLayout">
        <Setter Property="Spacing" Value="{DynamicResource GroupHeaderSpacing}" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="CollectionHeaderIcon" TargetType="Label">
        <Setter Property="FontSize" Value="{DynamicResource SmallFontSize}" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="TextColor" Value="{DynamicResource TextMutedColor}" />
        <Setter Property="WidthRequest" Value="{DynamicResource GroupIconWidth}" />
    </Style>

    <Style x:Key="CollectionHeaderName" TargetType="Label">
        <Setter Property="FontSize" Value="{DynamicResource SectionTitleFontSize}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource AccentColor}" />
    </Style>

    <Style x:Key="CollectionHeaderCount" TargetType="Label">
        <Setter Property="FontSize" Value="{DynamicResource SmallFontSize}" />
        <Setter Property="TextColor" Value="{DynamicResource TextMutedColor}" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="Margin" Value="{DynamicResource GroupCountMargin}" />
    </Style>

    <!-- Cards -->
    <Style x:Key="Card" TargetType="Frame">
        <Setter Property="Margin" Value="{DynamicResource CardMargin}" />
        <Setter Property="Padding" Value="{DynamicResource CardPadding}" />
        <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}" />
        <Setter Property="BorderColor" Value="{DynamicResource CardBorderColor}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource CardBackgroundColor}" />
        <Setter Property="Shadow" Value="{DynamicResource SurfaceShadow}" />
        <Setter Property="HasShadow" Value="False" />
    </Style>

    <Style x:Key="CardContentGrid" TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="{DynamicResource CardColumnSpacing}" />
    </Style>

    <Style x:Key="Favicon" TargetType="Border">
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="HeightRequest" Value="{DynamicResource FaviconSize}" />
        <Setter Property="WidthRequest" Value="{DynamicResource FaviconSize}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource FaviconBackgroundColor}" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="{DynamicResource FaviconCornerRadius}" />
        </Setter>
    </Style>

    <Style x:Key="FaviconPlaceholder" TargetType="Label">
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="FontSize" Value="{DynamicResource SectionTitleFontSize}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource TextMutedColor}" />
    </Style>

    <Style x:Key="CardTextColumn" TargetType="VerticalStackLayout">
        <Setter Property="Spacing" Value="{DynamicResource MetaSpacing}" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="CardTitleRow" TargetType="HorizontalStackLayout">
        <Setter Property="Spacing" Value="{DynamicResource InlineSpacing}" />
    </Style>

    <Style x:Key="CardTitle" TargetType="Label">
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="{DynamicResource SectionTitleFontSize}" />
    </Style>

    <Style x:Key="CardMeta" TargetType="Label">
        <Setter Property="FontSize" Value="{DynamicResource SmallFontSize}" />
        <Setter Property="TextColor" Value="{DynamicResource TextMutedColor}" />
        <Setter Property="VerticalOptions" Value="End" />
    </Style>

    <Style x:Key="CardSubtitle" TargetType="Label">
        <Setter Property="FontSize" Value="{DynamicResource DefaultFontSize}" />
        <Setter Property="TextColor" Value="{DynamicResource TextMutedColor}" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
    </Style>

    <Style x:Key="EmptyState" TargetType="Label">
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="FontSize" Value="{DynamicResource DefaultFontSize}" />
        <Setter Property="TextColor" Value="{DynamicResource TextMutedColor}" />
    </Style>

</ResourceDictionary>