<?xml version="1.0" encoding="UTF-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    x:Class="Privault.Resources.Styles.Themes.ClassicLight">

    <!-- ========================================================== -->
    <!-- Colors -->
    <!-- ========================================================== -->

    <!-- App / Layout -->
    <Color x:Key="PageBackgroundColor">#F2F4F7</Color>
    <Color x:Key="HeaderBackgroundColor">#F0F0F0</Color>

    <!-- Text -->
    <Color x:Key="TextPrimaryColor">#212121</Color>
    <Color x:Key="TextMutedColor">#757575</Color>

    <!-- Brand / Accent -->
    <Color x:Key="AccentColor">#0572EC</Color>
    <Color x:Key="AccentOnColor">White</Color>

    <!-- Borders  -->
    <Color x:Key="BorderColor">#D0D0D0</Color>

    <!-- Semantic -->
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceBorderColor">#E0E0E0</Color>

    <!-- Semantic -->
    <Color x:Key="DangerColor">DarkRed</Color>
    <Color x:Key="DangerOnColor">White</Color>
    <Color x:Key="WarningColor">#F59E0B</Color>

    <!-- Inputs -->
    <Color x:Key="InputBackgroundColor">#FFFFFF</Color>
    <Color x:Key="InputTextColor">#212121</Color>
    <Color x:Key="InputPlaceholderColor">#6E6E6E</Color>

    <!-- Buttons -->
    <Color x:Key="ButtonBackgroundColor">#0572EC</Color>
    <Color x:Key="ButtonTextColor">White</Color>
    <Color x:Key="ButtonPressedBackgroundColor">#005FB8</Color>
    <Color x:Key="ButtonDisabledBackgroundColor">#C8C8C8</Color>
    <Color x:Key="ButtonDisabledTextColor">#919191</Color>

    <!-- Overlay -->
    <Color x:Key="OverlayBackgroundColor">Silver</Color>

    <!-- Cards -->
    <Color x:Key="CardBorderColor">#E0E0E0</Color>
    <Color x:Key="CardHoverBackgroundColor">#F0F0F0</Color>
    <Color x:Key="CardPressedBackgroundColor">#E0E0E0</Color>
    <Color x:Key="CardBackgroundColor">#FFFFFF</Color>

    <!-- Favicon bubble -->
    <Color x:Key="FaviconBackgroundColor">#E0E0E0</Color>

    <!-- Meter (Password strength) -->
    <Color x:Key="Meter0Color">Gray</Color>
    <Color x:Key="Meter1Color">Red</Color>
    <Color x:Key="Meter2Color">Orange</Color>
    <Color x:Key="Meter3Color">YellowGreen</Color>
    <Color x:Key="Meter4Color">Green</Color>

    <!-- Access selection -->
    <Color x:Key="AccessSelectedTextColor">White</Color>
    <Color x:Key="AccessSelectedOnBackgroundColor">#0572EC</Color>
    <Color x:Key="AccessSelectedOffBackgroundColor">DarkGray</Color>

    <!-- ========================================================== -->
    <!-- Typography -->
    <!-- ========================================================== -->

    <!-- FontFamily -->
    <x:String x:Key="DefaultFontFamily">OpenSansRegular</x:String>

    <!-- FontSize -->
    <x:Double x:Key="DefaultFontSize">15</x:Double>
    <x:Double x:Key="SmallFontSize">12</x:Double>
    <x:Double x:Key="TinyFontSize">10</x:Double>
    <x:Double x:Key="CaptionFontSize">16</x:Double>
    <x:Double x:Key="HeadlineFontSize">32</x:Double>
    <x:Double x:Key="HeaderTitleFontSize">20</x:Double>
    <x:Double x:Key="SectionTitleFontSize">18</x:Double>
    <x:Double x:Key="HintFontSize">11</x:Double>
    <x:Double x:Key="FabFontSize">30</x:Double>
    <x:Double x:Key="IconButtonFontSize">18</x:Double>

    <!-- ========================================================== -->
    <!-- Spacing / Sizes / Radius -->
    <!-- ========================================================== -->

    <!-- Page -->
    <Thickness x:Key="PagePadding">20,20,20,30</Thickness>
    
    <!-- Header -->
    <Thickness x:Key="HeaderPadding">15</Thickness>
    <Thickness x:Key="LoginHeaderPadding">30,30,30,0</Thickness>
    <x:Double x:Key="LoginHeaderSpacing">5</x:Double>
    
    <!-- Body -->
    <x:Double x:Key="BodySpacing">25</x:Double>
    
    <!-- Section -->
    <x:Double x:Key="SectionSpacing">10</x:Double>
    
    <!-- Field -->
    <x:Double x:Key="FieldSpacing">10</x:Double>
    
    <!-- Inline -->
    <x:Double x:Key="InlineSpacing">6</x:Double>
    
    <!-- Meta -->
    <x:Double x:Key="MetaSpacing">8</x:Double>

    <!-- TwoColumnGrid -->
    <x:Double x:Key="TwoColumnGridSpacing">8</x:Double>

    <!-- Caption -->
    <Thickness x:Key="CaptionMargin">0,-5,0,0</Thickness>

    <!-- Surface -->
    <x:Single x:Key="SurfaceCornerRadius">12</x:Single>
    <Thickness x:Key="SurfacePadding">15</Thickness>

    <!-- Inputs -->
    <x:Double x:Key="InputHeight">48</x:Double>
    <x:Double x:Key="EditorMinHeight">80</x:Double>

    <!-- Buttons -->
    <x:Int32 x:Key="ButtonCornerRadius">12</x:Int32>
    <Thickness x:Key="ButtonPadding">14,10</Thickness>
    <x:Double x:Key="ButtonMinHeight">44</x:Double>
    <x:Double x:Key="FullButtonHeight">50</x:Double>

    <!-- SmallButtons -->
    <x:Double x:Key="SmallButtonHeight">36</x:Double>
    <Thickness x:Key="SmallButtonPadding">12,0</Thickness>

    <!-- TinyButtons -->
    <x:Double x:Key="TinyButtonHeight">36</x:Double>
    <x:Double x:Key="TinyButtonWidth">56</x:Double>
    <Thickness x:Key="TinyButtonPadding">8,0</Thickness>

    <!-- Header/Icon buttons -->
    <x:Double x:Key="HeaderButtonWidth">110</x:Double>
    <Thickness x:Key="HeaderButtonMargin">0,0,10,0</Thickness>

    <!-- Icons -->
    <x:Double x:Key="IconButtonWidth">48</x:Double>
    <Thickness x:Key="IconButtonMargin">5,0,0,0</Thickness>

    <!-- FAB -->
    <Thickness x:Key="FabMargin">30</Thickness>
    <x:Double x:Key="FabSize">60</x:Double>
    <x:Int32 x:Key="FabCornerRadius">30</x:Int32>

    <!-- Search -->
    <Thickness x:Key="SearchMargin">0,10,0,0</Thickness>
    <Thickness x:Key="SearchPadding">10,0</Thickness>
    <x:Double x:Key="BorderStrokeThickness">1</x:Double>
    <x:Double x:Key="SearchHeight">50</x:Double>

    <!-- Group header -->
    <Thickness x:Key="GroupHeaderPadding">10,15,10,5</Thickness>
    <x:Double x:Key="GroupHeaderSpacing">10</x:Double>
    <x:Double x:Key="GroupIconWidth">20</x:Double>
    <Thickness x:Key="GroupCountMargin">5,0,0,0</Thickness>

    <!-- Cards -->
    <Thickness x:Key="CardMargin">5,5</Thickness>
    <Thickness x:Key="CardPadding">15</Thickness>
    <x:Single x:Key="CardCornerRadius">14</x:Single>
    <x:Double x:Key="CardColumnSpacing">15</x:Double>

    <!-- Favicon -->
    <x:Double x:Key="FaviconSize">40</x:Double>
    <x:Single x:Key="FaviconCornerRadius">10</x:Single>

    <!-- Meter -->
    <Thickness x:Key="MeterMargin">0,-5,0,10</Thickness>
    <x:Double x:Key="MeterBarHeight">4</x:Double>
    <Thickness x:Key="MeterBarMargin">0,0,10,0</Thickness>

    <!-- Chips -->
    <x:Double x:Key="ChipHeight">32</x:Double>
    <x:Int32 x:Key="ChipCornerRadius">16</x:Int32>
    <Thickness x:Key="ChipGroupMargin">0,-6,0,0</Thickness>
    <x:Double x:Key="ChipMinWidth">80</x:Double>
    <Thickness x:Key="ChipPadding">12,0</Thickness>
    <x:Double x:Key="ChipItemSpacing">8</x:Double>
    <x:Double x:Key="ChipGroupHeight">44</x:Double>

    <!-- Access buttons -->
    <x:Double x:Key="AccessButtonWidth">70</x:Double>
    <x:Double x:Key="AccessButtonHeight">32</x:Double>
    <x:Int32 x:Key="AccessButtonCornerRadius">12</x:Int32>

    <!-- Collections -->
    <Thickness x:Key="CollectionMargin">0,10,0,0</Thickness>

    <!-- Warning -->
    <Thickness x:Key="WarningPadding">12</Thickness>
    <Thickness x:Key="WarningMargin">0,10,0,0</Thickness>

    <!-- Thumbnails -->
    <x:Double x:Key="ThumbnailSize">48</x:Double>

    <!-- ========================================================== -->
    <!-- Shapes -->
    <!-- ========================================================== -->

    <RoundRectangle x:Key="SearchShape" CornerRadius="12" />

    <!-- ========================================================== -->
    <!-- Shadows (aus) -->
    <!-- ========================================================== -->

    <Shadow x:Key="SurfaceShadow" Brush="#00000000" Offset="0,0" Radius="0" Opacity="1" />
    <Shadow x:Key="ButtonShadow" Brush="#00000000" Offset="0,0" Radius="0" Opacity="1" />
    <Shadow x:Key="ButtonPressedShadow" Brush="#00000000" Offset="0,0" Radius="0" Opacity="1" />
    <Shadow x:Key="DisabledShadow" Brush="#00000000" Offset="0,0" Radius="0" Opacity="1" />

</ResourceDictionary>