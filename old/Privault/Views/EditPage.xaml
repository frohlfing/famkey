<?xml version="1.0"
      encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Privault.Core.ViewModels;assembly=Privault.Core"
             xmlns:helpers="clr-namespace:Privault.Helpers"
             x:Class="Privault.Views.EditPage"
             x:DataType="vm:EditViewModel"
             x:Name="MyEditPage"
             Shell.NavBarIsVisible="False"
             Title="Eintrag">

    <ContentPage.Resources>
        <ResourceDictionary>
            <helpers:InvertedBoolConverter x:Key="InvertedBoolConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>
    
    <Grid RowDefinitions="Auto, *">

        <!-- Kopfzeile -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto, *, Auto"
              Style="{StaticResource Header}">
            <Button Grid.Column="0"
                    Text="close"
                    Command="{Binding CancelCommand}"
                    ToolTipProperties.Text="Zurück"
                    Style="{StaticResource IconButton}"/>
            <Label Grid.Column="1"
                   Text="{Binding Title}"
                   IsVisible="{Binding HasTitle}"
                   Style="{StaticResource HeaderTitle}"/>
            <Label Grid.Column="1"
                   Text="Ohne Titel"
                   IsVisible="{Binding HasTitle, Converter={StaticResource InvertedBoolConverter}}"
                   Style="{StaticResource HeaderTitle}"/>
            <Button Grid.Column="2"
                    Text="check"
                    Command="{Binding OkCommand}"
                    ToolTipProperties.Text="Speichern"
                    IsEnabled="{Binding CanWrite}"
                    Style="{StaticResource IconButton}"/>
        </Grid>

        <!-- Hauptinhalt -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Style="{StaticResource Body}">

                <!-- Kategorie -->
                <VerticalStackLayout IsEnabled="{Binding CanWrite}"
                                     Style="{StaticResource FieldGroup}">
                    <Label Text="Kategorie"
                           Style="{StaticResource FieldLabel}"/>
                    <Entry Text="{Binding Category}"
                           Placeholder="{Binding CategoryPlaceholder}"/>

                    <CollectionView ItemsSource="{Binding ExistingCategories}"
                                    Style="{StaticResource ChipButtonGroup}">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal"
                                               ItemSpacing="{DynamicResource ChipItemSpacing}"/>
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Button Text="{Binding .}"
                                        Command="{Binding BindingContext.SelectCategoryCommand, Source={x:Reference MyEditPage}}"
                                        CommandParameter="{Binding .}"
                                        Style="{StaticResource ChipButton}"/>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- Titel -->
                <VerticalStackLayout IsEnabled="{Binding CanWrite}"
                                     Style="{StaticResource FieldGroup}">
                    <Label Text="Titel"
                           Style="{StaticResource FieldLabel}"/>
                    <Entry Text="{Binding Title}"
                           Placeholder="z.B. Google"/>
                </VerticalStackLayout>

                <!-- Benutzername -->
                <VerticalStackLayout IsEnabled="{Binding CanWrite}"
                                     Style="{StaticResource FieldGroup}">
                    <Label Text="Benutzername"
                           Style="{StaticResource FieldLabel}"/>
                    <Entry Text="{Binding Username}"
                           Placeholder="user@mail.com"
                           IsSpellCheckEnabled="False"
                           Keyboard="Email"/>
                </VerticalStackLayout>

                <!-- Passwort-Management -->
                <VerticalStackLayout IsEnabled="{Binding CanWrite}"
                                     Style="{StaticResource FieldGroup}">
                    <Label Text="Passwort"
                           Style="{StaticResource FieldLabel}"/>
                    <Grid ColumnDefinitions="*, Auto, Auto">
                        <Entry Grid.Column="0"
                               Text="{Binding Password}"
                               IsPassword="{Binding IsPasswordHidden}"
                               Placeholder="Geheim"/>
                        <!-- Passwort-Sichtbarkeit umschalten -->
                        <Button Grid.Column="1"
                                Text="visibility"
                                Command="{Binding TogglePasswordCommand}"
                                ToolTipProperties.Text="Passwort ein-/ausblenden"
                                Style="{StaticResource IconButton}"/>
                        <!-- Zufallspasswort generieren -->
                        <Button Grid.Column="2"
                                Text="star_shine"
                                Command="{Binding GeneratePasswordCommand}"
                                ToolTipProperties.Text="Passwort generieren"
                                Style="{StaticResource IconButton}"/>
                    </Grid>
                </VerticalStackLayout>

                <!-- Passwortstärke -->
                <Grid ColumnDefinitions="*, Auto"
                      Style="{StaticResource Meter}">
                    <ProgressBar Grid.Column="0"
                                 Style="{StaticResource MeterBar}">
                        <ProgressBar.Triggers>
                            <DataTrigger TargetType="ProgressBar"
                                         Binding="{Binding PasswordStrength}"
                                         Value="0">
                                <Setter Property="Progress"
                                        Value="0"/>
                                <Setter Property="ProgressColor"
                                        Value="{DynamicResource Meter0Color}"/>
                            </DataTrigger>
                            <DataTrigger TargetType="ProgressBar"
                                         Binding="{Binding PasswordStrength}"
                                         Value="1">
                                <Setter Property="Progress"
                                        Value="0.25"/>
                                <Setter Property="ProgressColor"
                                        Value="{DynamicResource Meter1Color}"/>
                            </DataTrigger>
                            <DataTrigger TargetType="ProgressBar"
                                         Binding="{Binding PasswordStrength}"
                                         Value="2">
                                <Setter Property="Progress"
                                        Value="0.5"/>
                                <Setter Property="ProgressColor"
                                        Value="{DynamicResource Meter2Color}"/>
                            </DataTrigger>
                            <DataTrigger TargetType="ProgressBar"
                                         Binding="{Binding PasswordStrength}"
                                         Value="3">
                                <Setter Property="Progress"
                                        Value="0.75"/>
                                <Setter Property="ProgressColor"
                                        Value="{DynamicResource Meter3Color}"/>
                            </DataTrigger>
                            <DataTrigger TargetType="ProgressBar"
                                         Binding="{Binding PasswordStrength}"
                                         Value="4">
                                <Setter Property="Progress"
                                        Value="1.0"/>
                                <Setter Property="ProgressColor"
                                        Value="{DynamicResource Meter4Color}"/>
                            </DataTrigger>
                        </ProgressBar.Triggers>
                    </ProgressBar>

                    <Label Grid.Column="1"
                           Style="{StaticResource MeterLabel}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label"
                                         Binding="{Binding PasswordStrength}"
                                         Value="0">
                                <Setter Property="Text"
                                        Value=""/>
                            </DataTrigger>
                            <DataTrigger TargetType="Label"
                                         Binding="{Binding PasswordStrength}"
                                         Value="1">
                                <Setter Property="Text"
                                        Value="Sehr schwach"/>
                                <Setter Property="TextColor"
                                        Value="{DynamicResource Meter1Color}"/>
                            </DataTrigger>
                            <DataTrigger TargetType="Label"
                                         Binding="{Binding PasswordStrength}"
                                         Value="2">
                                <Setter Property="Text"
                                        Value="Schwach"/>
                                <Setter Property="TextColor"
                                        Value="{DynamicResource Meter2Color}"/>
                            </DataTrigger>
                            <DataTrigger TargetType="Label"
                                         Binding="{Binding PasswordStrength}"
                                         Value="3">
                                <Setter Property="Text"
                                        Value="Gut"/>
                                <Setter Property="TextColor"
                                        Value="{DynamicResource Meter3Color}"/>
                            </DataTrigger>
                            <DataTrigger TargetType="Label"
                                         Binding="{Binding PasswordStrength}"
                                         Value="4">
                                <Setter Property="Text"
                                        Value="Stark"/>
                                <Setter Property="TextColor"
                                        Value="{DynamicResource Meter4Color}"/>
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Grid>

                <!-- URL -->
                <VerticalStackLayout IsEnabled="{Binding CanWrite}"
                                     Style="{StaticResource FieldGroup}">
                    <Label Text="URL"
                           Style="{StaticResource FieldLabel}"/>
                    <Entry Text="{Binding Url}"
                           Placeholder="https://..."
                           Keyboard="Url"
                           IsTextPredictionEnabled="False"/>
                </VerticalStackLayout>

                <!-- Notiz -->
                <VerticalStackLayout IsEnabled="{Binding CanWrite}"
                                     Style="{StaticResource FieldGroup}">
                    <Label Text="Notizen"
                           Style="{StaticResource FieldLabel}"/>
                    <Editor Text="{Binding Notes}"
                            AutoSize="TextChanges"
                            Keyboard="Text"/>
                </VerticalStackLayout>

                <!-- Löschen (Nur sichtbar im EditMode) -->
                <Button Text="Eintrag löschen"
                        Command="{Binding DeleteCommand}"
                        IsVisible="{Binding IsEditMode}"
                        IsEnabled="{Binding HasFullAccess}"
                        Style="{StaticResource DangerFullButton}"/>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Ladeanzeige (Nicht blockierend) -->
        <VerticalStackLayout Grid.Row="0"
                             Grid.RowSpan="2"
                             IsVisible="{Binding IsLoading}"
                             Style="{StaticResource Loader}">
            <ActivityIndicator IsRunning="{Binding IsLoading}"/>
            <Label Text="Entschlüssele Daten..."
                   Style="{StaticResource LoaderText}"/>
        </VerticalStackLayout>
    </Grid>
</ContentPage>