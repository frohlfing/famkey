<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <!-- App-Versionen -->
        <Version>1.0.0</Version>
    </PropertyGroup>

    <ItemGroup>
        <!-- Minimal erforderliche Server-Minor-Version -->
        <AssemblyMetadata Include="RequiredServerMinor" Value="0" />

        <!-- Tests dürfen auf Interals zugreifen-->
        <InternalsVisibleTo Include="Privault.Tests" />

        <!-- Packages -->
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
        <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.3" />
        <PackageReference Include="Plugin.Fingerprint" Version="2.1.5" />
        <PackageReference Include="sqlite-net-sqlcipher" Version="1.9.172" />
        <PackageReference Include="SQLitePCLRaw.bundle_e_sqlcipher" Version="2.1.11" />
        <PackageReference Include="SQLitePCLRaw.core" Version="3.0.2" />
        <PackageReference Include="zxcvbn-core" Version="7.0.92" />
    </ItemGroup>

</Project>
