# Directory Listing verbieten
# Niemand soll sehen, welche Dateien im Ordner liegen
Options -Indexes

RewriteEngine On

# Authorization an PHP übergeben
RewriteCond %{HTTP:Authorization} ^(.*)
RewriteRule .* - [e=HTTP_AUTHORIZATION:%1]

# HTTPS erzwingen – nur für Hostnamen, nicht für IP-Adressen (lokale Entwicklung via IP)
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} !^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$
RewriteRule (.*) https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Multi-Tenant-Regel (REQUEST_URI bleibt dabei erhalten, PHP liest den org_slug daraus)
# - RewriteCond prüft, ob der URI mit /org/{slug}/ beginnt
# - RewriteRule schneidet den Präfix org/{slug}/ ab und leitet intern auf $1 weiter — den Rest des Pfads
# - [QSA] hängt den Query-String (?domain=...) an
# - [L] beendet die Regelkette
RewriteCond %{REQUEST_URI} ^/org/[a-z0-9][a-z0-9-]{0,63}/
RewriteRule ^org/[a-z0-9][a-z0-9-]{0,63}/(.*)$ $1 [QSA,L]

# Zugriff auf sensible Dateien blockieren (falls man sie doch versehentlich hier ablegt)
<FilesMatch "\.(env|sql|log|ini)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>
